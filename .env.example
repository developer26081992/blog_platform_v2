# Copy this file to .env and replace the placeholders locally.
# Application connection: copy the pooled connection string from Neon Connect.
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require"
# Migration connection: copy the direct (non-pooled) Neon connection string.
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Signs and verifies session JWTs. Use a random secret of at least 32 bytes.
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-bytes"
